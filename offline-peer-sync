#!/usr/bin/env bash

set -uo pipefail
IFS=$'\n\t'

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"
}

if ! command -v rsync >/dev/null || ! command -v ip >/dev/null; then
  log "rsync or ip is not installed"
  exit 1
fi

declare -A candidates=()

while read -r address iface; do
  [[ -n "${address:-}" && "$address" != "127."* ]] || continue
  if [[ "$address" == */* ]]; then
    for ip in $(python3 - "$address" <<'PY'
import ipaddress, sys
network = ipaddress.ip_network(sys.argv[1], strict=False)
if network.num_addresses <= 4096:
    for address in network.hosts():
        print(address)
PY
); do
      candidates["$ip"]=1
    done
  fi
done < <(ip -o -4 addr show scope global | awk '{print $4, $2}')

local_addresses="$(ip -o -4 addr show scope global | awk '{print $4}' | cut -d/ -f1)"
for ip in "${!candidates[@]}"; do
  if grep -Fxq "$ip" <<<"$local_addresses"; then
    continue
  fi
  if timeout 1 bash -c "exec 3<>/dev/tcp/$ip/47001" 2>/dev/null; then
    log "Found offline peer $ip"
    for module in knowledge media; do
      rsync -az --timeout=30 --update "rsync://$ip:47001/$module/" "/srv/offline/$module/" &&
        log "Synced $module from $ip"
    done
  fi
done
