<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces this system to other Offline systems on the local network. -->
<service-group>
  <name replace-wildcards="yes">Offline library on %h</name>
  <service>
    <type>_offline-sync._tcp</type>
    <port>47002</port>
    <txt-record>v=3</txt-record>
  </service>
</service-group>
