# Offline application: Meshtastic Web
# Installed, started and removed with "sudo offline apps". The container's root user is
# mapped to an unprivileged range on the host, it cannot gain privileges, and its port is
# published on 127.0.0.1 only.

[Unit]
Description=Offline app: Meshtastic Web
Documentation=https://github.com/pbassill/offline
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=offline-app-meshtastic-web
Image=ghcr.io/meshtastic/web:2.7.1@sha256:f78433efca7766637fd0f11bc4bb299a7ddacb3118c3fc1210b0bee501229b08
PublishPort=127.0.0.1:18450:8080
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--pull=never --uidmap=0:1300000:65536 --gidmap=0:1300000:65536 --memory=128m --pids-limit=512

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
