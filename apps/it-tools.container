# Offline application: IT Tools
# Installed, started and removed with "sudo offline apps". The container's root user is
# mapped to an unprivileged range on the host, it cannot gain privileges, and its port is
# published on 127.0.0.1 only.

[Unit]
Description=Offline app: IT Tools
Documentation=https://github.com/pbassill/offline
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=offline-app-it-tools
Image=ghcr.io/corentinth/it-tools:2024.10.22-7ca5933@sha256:8b8128748339583ca951af03dfe02a9a4d7363f61a216226fc28030731a5a61f
PublishPort=127.0.0.1:18430:80
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--pull=never --uidmap=0:1100000:65536 --gidmap=0:1100000:65536 --memory=128m --pids-limit=512

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
