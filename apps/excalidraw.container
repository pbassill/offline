# Offline application: Excalidraw
# Installed, started and removed with "sudo offline apps". The container's root user is
# mapped to an unprivileged range on the host, it cannot gain privileges, and its port is
# published on 127.0.0.1 only.

[Unit]
Description=Offline app: Excalidraw
Documentation=https://github.com/pbassill/offline
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=offline-app-excalidraw
Image=docker.io/excalidraw/excalidraw:sha-4bfc5bb@sha256:3d243e15afde6c6511be36b14cef3d095b9d91bcd35ba98aca3b546f4b477df9
PublishPort=127.0.0.1:18440:80
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--pull=never --uidmap=0:1200000:65536 --gidmap=0:1200000:65536 --memory=128m --pids-limit=512

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
