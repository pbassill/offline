# Offline application: Homebox
# Installed, started and removed with "sudo offline apps". The container's root user is
# mapped to an unprivileged range on the host, it cannot gain privileges, and its port is
# published on 127.0.0.1 only.

[Unit]
Description=Offline app: Homebox
Documentation=https://github.com/pbassill/offline
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=offline-app-homebox
Image=ghcr.io/sysadminsmedia/homebox:0.26.2@sha256:b1ad7e3c63f732a5f6daa466e8116be4f545b3b120383a64dcb62beb00a660cc
PublishPort=127.0.0.1:18470:7745
Volume=/srv/offline/apps/homebox/data:/data:U
Environment=HBOX_OPTIONS_CHECK_GITHUB_RELEASE=false
EnvironmentFile=/etc/offline/apps/homebox.env
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--pull=never --uidmap=0:1600000:65536 --gidmap=0:1600000:65536 --memory=256m --pids-limit=512

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
