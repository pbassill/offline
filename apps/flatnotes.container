# Offline application: Flatnotes
# Installed, started and removed with "sudo offline apps". The container's root user is
# mapped to an unprivileged range on the host, it cannot gain privileges, and its port is
# published on 127.0.0.1 only.

[Unit]
Description=Offline app: Flatnotes
Documentation=https://github.com/pbassill/offline
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=offline-app-flatnotes
Image=docker.io/dullage/flatnotes:v5.5.4@sha256:a509830073d6548d35450a98be3a432716430b674cc70ac93cbbaed1555b5a28
PublishPort=127.0.0.1:18200:8080
Volume=/srv/offline/apps/flatnotes/data:/data:U
EnvironmentFile=/etc/offline/apps/flatnotes.env
NoNewPrivileges=true
LogDriver=journald
PodmanArgs=--pull=never --uidmap=0:1500000:65536 --gidmap=0:1500000:65536 --memory=256m --pids-limit=512

[Service]
Restart=on-failure
RestartSec=15
TimeoutStartSec=300
