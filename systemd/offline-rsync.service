[Unit]
Description=Offline content sharing daemon (rsync, 127.0.0.1:47001)
Documentation=https://github.com/pbassill/offline
After=network.target
ConditionPathExists=/etc/offline/rsyncd.secrets

[Service]
Type=simple
User=offline
Group=offline
ExecStart=/usr/bin/rsync --daemon --no-detach --config=/etc/offline/rsyncd.conf --port=47001
Restart=on-failure
RestartSec=10

# Read-only view of the system; the daemon only ever serves files. Its one
# writable path holds the connection-count lock.
ProtectSystem=strict
ReadWritePaths=/run/offline /var/lib/offline/inbox
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
# This machine only: other systems come through offline-tls.service.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
