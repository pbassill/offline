[Unit]
Description=Offline portal: end sessions that have run out or whose account has changed
Documentation=https://github.com/pbassill/offline
ConditionPathIsDirectory=/run/offline-auth

[Service]
Type=oneshot
User=offline-auth
Group=offline-auth
SupplementaryGroups=offline-session
ExecStart=/usr/local/bin/offline user prune-sessions
ReadWritePaths=/run/offline-auth

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
IPAddressDeny=any
