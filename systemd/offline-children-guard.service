# Loads the firewall rules that confine children's login accounts (group
# offline-child): they reach the portal, the children's shelf and the games, on
# this system and on the home network, and nothing else. The rules sit in a
# table of their own and leave the rest of the firewall as it is.
[Unit]
Description=Offline children's guard (network rules for child accounts)
Documentation=https://github.com/pbassill/offline
Before=display-manager.service systemd-user-sessions.service
After=nss-user-lookup.target
ConditionPathExists=/usr/local/lib/offline/children-guard.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/local/lib/offline/children-guard.nft
ExecStop=/usr/sbin/nft delete table inet offline_children

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
