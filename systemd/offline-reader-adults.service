# The whole library. It listens on this system only; browsers reach it through
# the web server on port 8443, which admits adults who have signed in.
[Unit]
Description=Offline library reader for adults (kiwix-serve, this system only, TCP 8090)
Documentation=https://github.com/pbassill/offline
After=network.target
ConditionPathExists=/var/lib/offline/library.xml

[Service]
Type=simple
User=offline
Group=offline
ExecStart=/usr/bin/kiwix-serve --address=127.0.0.1 --port=8090 --monitorLibrary --blockexternal --library /var/lib/offline/library.xml
Restart=on-failure
RestartSec=10

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
